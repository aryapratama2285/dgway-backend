APP_NAME="DG Way"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dgway
DB_USERNAME=dgway
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# API-only: no server-side sessions
SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# DG Way
DGWAY_BUSINESS_TIMEZONE=Asia/Jakarta
DGWAY_TOKEN_TTL_DAYS=30
# F5A: reverse proxy whose X-Forwarded-* headers are trusted (empty = none; production: the proxy network, e.g. 172.16.0.0/12)
DGWAY_TRUSTED_PROXIES=
